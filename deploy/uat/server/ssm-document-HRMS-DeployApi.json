{
  "schemaVersion": "2.2",
  "description": "Deploy an HRMS API release to the UAT server (fixed script, validated parameters). Used by GitHub Actions deploy-uat-api.yml.",
  "parameters": {
    "ArtifactUrl": {
      "type": "String",
      "description": "Presigned HTTPS URL of the release tarball in the artifact bucket.",
      "allowedPattern": "^https://apex-hrms-api-artifacts-306855880046-ap-southeast-1\\.s3(\\.ap-southeast-1)?\\.amazonaws\\.com/api/[0-9a-f]{40}\\.tar\\.gz\\?[A-Za-z0-9%&=._-]+$"
    },
    "Sha256": {
      "type": "String",
      "description": "SHA-256 of the tarball.",
      "allowedPattern": "^[a-f0-9]{64}$"
    },
    "Commit": {
      "type": "String",
      "description": "Git commit being deployed.",
      "allowedPattern": "^[0-9a-f]{7,40}$"
    }
  },
  "mainSteps": [
    {
      "action": "aws:runShellScript",
      "name": "deployApi",
      "inputs": {
        "timeoutSeconds": "600",
        "runCommand": ["/usr/local/sbin/hrms-deploy-api '{{ ArtifactUrl }}' '{{ Sha256 }}' '{{ Commit }}'"]
      }
    }
  ]
}
