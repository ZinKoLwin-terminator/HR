# Copy to uat.local.env (git-ignored) and fill in the values of your UAT environment.
# Never commit uat.local.env: it identifies the database and who may reach it.
RDS_ENDPOINT=<instance>.<id>.<region>.rds.amazonaws.com
RDS_ADMIN_LOGIN=<RDS master login>
RDS_SECURITY_GROUP=<sg-... that allows port 1433>
API_HOST=<public IP or host name of the API server>
