      "action": "approveResolution",
      "actor": "reviewer",
      "input": { "visibleToSubmitter": false, "comment": "Disciplinary detail stays internal." },
      "expected": { "status": "Resolved", "resolutionVisibleToSubmitter": false, "proposalDecision": "Approved" }
    },
    {
      "name": "approve: nobody approves their own proposal",
      "case": { "status": "ResolutionProposed", "proposedBy": "management" },
      "action": "approveResolution",
      "actor": "management",
      "input": { "visibleToSubmitter": true, "comment": null },
      "expectedError": { "type": "Forbidden" }
    },
    {
      "name": "approve: only a proposed resolution can be approved",
      "case": { "status": "UnderReview" },
      "action": "approveResolution",
      "actor": "reviewer",
      "input": { "visibleToSubmitter": true, "comment": null },
      "expectedError": { "type": "Conflict" }
    },
    {
      "name": "reject resolution: back to the investigation when there is a lead",
      "case": { "status": "ResolutionProposed", "hasLead": true },
      "action": "rejectResolution",
      "actor": "reviewer",
      "input": { "reason": "Interview the second witness first." },
      "expected": {
        "status": "UnderInvestigation",
        "proposalDecision": "Rejected",
        "history": [ { "action": "RejectResolution", "fromStatus": "ResolutionProposed", "toStatus": "UnderInvestigation", "actorRole": "Reviewer", "visibleToSubmitter": false, "reason": "Interview the second witness first." } ]
      }
    },
    {
      "name": "reject resolution: back to review when there is no lead",
      "case": { "status": "ResolutionProposed" },
      "action": "rejectResolution",
      "actor": "reviewer",
      "input": { "reason": "Consider mediation." },
      "expected": { "status": "UnderReview", "proposalDecision": "Rejected" }
    },
    {
      "name": "reject resolution: a reason is required",
      "case": { "status": "ResolutionProposed", "hasLead": true },
      "action": "rejectResolution",
      "actor": "reviewer",
      "input": { "reason": null },
      "expectedError": { "type": "Validation", "fields": [ "reason" ] }
    },
    {
      "name": "reject resolution: nobody rejects their own proposal",
      "case": { "status": "ResolutionProposed", "hasLead": true, "proposedBy": "investigator" },
      "action": "rejectResolution",
      "actor": "investigator",
      "input": { "reason": "Changed my mind." },
      "expectedError": { "type": "Forbidden" }
    },
    {
      "name": "close: a resolved case is closed",
      "case": { "status": "Resolved" },
      "action": "close",
      "actor": "management",
      "expected": {
        "status": "Closed",
        "history": [ { "action": "Close", "fromStatus": "Resolved", "toStatus": "Closed", "actorRole": "Management", "visibleToSubmitter": true, "reason": null } ]
      }
    },
    {
      "name": "close: an open case is resolved first",
      "case": { "status": "UnderInvestigation" },
      "action": "close",
      "actor": "management",
      "expectedError": { "type": "Conflict" }
    },
    {
      "name": "reopen: a closed case is reopened with a reason",
      "case": { "status": "Closed" },
      "action": "reopen",
      "actor": "management",
      "input": { "reason": "The submitter reported the same behaviour again." },
      "expected": {
        "status": "Reopened",
        "history": [ { "action": "Reopen", "fromStatus": "Closed", "toStatus": "Reopened", "actorRole": "Management", "visibleToSubmitter": true, "reason": "The submitter reported the same behaviour again." } ]
      }
    },
    {
      "name": "reopen: reopening ends every active assignment, the lead included",
      "case": { "status": "Closed", "hasLead": true },
      "action": "reopen",
      "actor": "management",
      "input": { "reason": "New facts were reported." },
      "expected": {
        "status": "Reopened",
        "endedAssignments": [ 300 ],
        "history": [
          { "action": "Reopen", "fromStatus": "Closed", "toStatus": "Reopened", "actorRole": "Management", "visibleToSubmitter": true, "reason": "New facts were reported." },
          { "action": "Unassign", "fromStatus": "Reopened", "toStatus": "Reopened", "actorRole": "Management", "visibleToSubmitter": false, "reason": "Case reopened" }
        ]
      }
    },
    {
      "name": "assign: the lead of a reopened case can be assigned again",
      "case": { "status": "Reopened", "hasLead": true },
      "action": "assign",
      "actor": "management",
      "input": { "investigatorEmployeeId": 300, "role": "Lead", "reason": null },
      "expected": {
        "status": "Assigned",
        "assignment": { "investigatorEmployeeId": 300, "role": "Lead" },
        "endedAssignment": null,
        "history": [ { "action": "Assign", "fromStatus": "Reopened", "toStatus": "Assigned", "actorRole": "Management", "visibleToSubmitter": true, "reason": null } ]
      }
    },
    {
      "name": "start investigation: the lead assigned again after a reopening continues the investigation",
      "case": { "status": "Assigned", "hasLead": true, "reassignedAfterReopen": true },
      "action": "startInvestigation",
      "actor": "investigator",
      "expected": {
        "status": "UnderInvestigation",
        "history": [ { "action": "StartInvestigation", "fromStatus": "Assigned", "toStatus": "UnderInvestigation", "actorRole": "Investigator", "visibleToSubmitter": true, "reason": null } ]
      }
    },
    {
      "name": "reopen: a rejected case can be reopened",
      "case": { "status": "Rejected" },
      "action": "reopen",
      "actor": "management",
      "input": { "reason": "New evidence." },
      "expected": { "status": "Reopened", "rejectionReason": "TST rejected on the way." }
    },
    {
      "name": "reopen: a reason is required",
      "case": { "status": "Resolved" },
      "action": "reopen",
      "actor": "management",
      "input": { "reason": "" },
      "expectedError": { "type": "Validation", "fields": [ "reason" ] }
    },
    {
      "name": "reopen: an archived case is never reopened",
      "case": { "status": "Closed", "archived": true },
      "action": "reopen",
      "actor": "management",
      "input": { "reason": "New evidence." },
      "expectedError": { "type": "Conflict" }
    },
    {
      "name": "reopen: an open case is not reopened",
      "case": { "status": "UnderReview" },
      "action": "reopen",
      "actor": "management",
      "input": { "reason": "Why not." },
      "expectedError": { "type": "Conflict" }
    },
    {
      "name": "escalate: an open case is escalated without a status change",
      "case": { "status": "UnderReview" },
      "action": "escalate",
      "actor": "management",
      "input": { "reason": "Senior manager involved." },
      "expected": {
        "status": "UnderReview",
        "isEscalated": true,
        "history": [ { "action": "Escalate", "fromStatus": "UnderReview", "toStatus": "UnderReview", "actorRole": "Management", "visibleToSubmitter": false, "reason": "Senior manager involved." } ]
      }
    },
    {
      "name": "escalate: an assigned investigator can escalate",
      "case": { "status": "UnderInvestigation" },
      "action": "escalate",
      "actor": "investigator",
      "input": { "reason": "Possible retaliation." },
      "expected": {
        "status": "UnderInvestigation",
        "isEscalated": true,
        "history": [ { "action": "Escalate", "fromStatus": "UnderInvestigation", "toStatus": "UnderInvestigation", "actorRole": "Investigator", "visibleToSubmitter": false, "reason": "Possible retaliation." } ]
      }
    },
    {
      "name": "escalate: a case is escalated once",
      "case": { "status": "Acknowledged", "isEscalated": true },
      "action": "escalate",
      "actor": "management",
      "input": { "reason": "Again." },
      "expectedError": { "type": "Conflict" }
    },
    {
      "name": "escalate: a reason is required",
      "case": { "status": "Acknowledged" },
      "action": "escalate",
      "actor": "management",
      "input": { "reason": null },
      "expectedError": { "type": "Validation", "fields": [ "reason" ] }
    },
    {
      "name": "escalate: a resolved case is no longer escalated",
      "case": { "status": "Resolved" },
      "action": "escalate",
      "actor": "management",
      "input": { "reason": "Late concern." },
      "expectedError": { "type": "Conflict" }
    },
    {
      "name": "archive: a closed case is archived and keeps its status",
      "case": { "status": "Closed" },
      "action": "archive",
      "actor": "management",
      "expected": {
        "status": "Closed",
        "archived": true,
        "history": [ { "action": "Archive", "fromStatus": "Closed", "toStatus": "Closed", "actorRole": "Management", "visibleToSubmitter": false, "reason": null } ]
      }
    },
    {
      "name": "archive: a rejected case can be archived",
      "case": { "status": "Rejected" },
      "action": "archive",
      "actor": "management",
      "expected": { "status": "Rejected", "archived": true }
    },
    {
      "name": "archive: a case on legal hold is not archived",
      "case": { "status": "Closed", "legalHold": true },
      "action": "archive",
      "actor": "management",
      "expectedError": { "type": "Conflict" }
    },
    {
      "name": "archive: an archived case is not archived again",
      "case": { "status": "Rejected", "archived": true },
      "action": "archive",
      "actor": "management",
      "expectedError": { "type": "Conflict" }
    },
    {
      "name": "archive: an open case is not archived",
      "case": { "status": "UnderReview" },
      "action": "archive",
      "actor": "management",
      "expectedError": { "type": "Conflict" }
    },
    {
      "name": "closed is final: no review on a closed case",
      "case": { "status": "Closed" },
      "action": "startReview",
      "actor": "management",
      "expectedError": { "type": "Conflict" }
    },
    {
      "name": "closed is final: no escalation of a closed case",
      "case": { "status": "Closed" },
      "action": "escalate",
      "actor": "management",
      "input": { "reason": "Late concern." },
      "expectedError": { "type": "Conflict" }
    },
    {
      "name": "closed is final: no new investigator on a closed case",
      "case": { "status": "Closed" },
      "action": "assign",
      "actor": "management",
      "input": { "investigatorEmployeeId": 301, "role": "Member", "reason": null },
      "expectedError": { "type": "Conflict" }
    },
    {
      "name": "reopened: a lead on a reopened case moves it to Assigned",
      "case": { "status": "Reopened", "reopenedFrom": "Rejected" },
      "action": "assign",
      "actor": "management",
      "input": { "investigatorEmployeeId": 300, "role": "Lead", "reason": null },
      "expected": { "status": "Assigned", "assignment": { "investigatorEmployeeId": 300, "role": "Lead" } }
    }
  ]
}
