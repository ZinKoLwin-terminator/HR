# Dart / Flutter
.dart_tool/
.packages
.pub-cache/
.pub/
build/

# pubspec.lock IS committed: this is an application, not a library, so every
# developer and every CI run must resolve the same dependency versions.

# Generated code (regenerate with: dart run build_runner build)
*.g.dart
*.freezed.dart

# Screenshot archive. The PNGs under screenshots/ are committed as the visual
# reference; the zip is just a convenience bundle and is rebuilt on demand.
*.zip

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws

# OS
.DS_Store
Thumbs.db

# Environment / secrets - never commit real endpoints or keys
.env
.env.*
!.env.example
android/key.properties
android/app/upload-keystore.jks
ios/Runner/GoogleService-Info.plist
android/app/google-services.json

# Flutter tooling
.flutter-plugins
.flutter-plugins-dependencies
.metadata

# Golden-test failure diffs, written on every mismatched run
test/screenshots/failures/

# Stray local images
/image.png
